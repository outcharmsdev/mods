+static_assert(lm::off::Tess_mColorRun == 0x70, "was `t + 0x70` at the texBlock colour-run reads");
+static_assert(lm::off::Tess_mVertexCount == 0x290, "was `t + 0x290` in texCut and the texBlock cut check");
+static_assert(lm::off::Tess_mOffset == 0x1cc, "was `tess + 0x1cc` in texSetOffset and TessOffsetGuard");
+static_assert(lm::off::BlockTess_mRenderFlag == 0x78, "was `f.bt + 0x78` at the BlockTessellator flag write");
+
+// The offsets that were ALREADY centralised must not have moved either: they are read on the render hot
+// path and a silent change here would be a crash or a wrong camera.
+static_assert(lm::off::LevelRenderer_mLevelRendererPlayer == 0x420, "pre-existing");
+static_assert(lm::off::LevelRendererPlayer_mCamPos == 0x628, "pre-existing");
+static_assert(lm::off::ScreenContext_mTessellator == 0xB8, "pre-existing");
+static_assert(lm::off::ScreenContext_mColorHolder == 0x30, "pre-existing");
+static_assert(lm::off::Actor_mDimension == 448, "pre-existing");
+static_assert(lm::off::Actor_mStateVector == 0x208, "pre-existing");
+static_assert(lm::off::Actor_mRotation == 0x218, "pre-existing");
+static_assert(lm::off::Dimension_mBlockSource == 208, "pre-existing");
+static_assert(lm::off::MaterialGroup_mRenderMaterialGroup == 32, "pre-existing");
+static_assert(lm::off::VT_RenderMaterialGroup_getMaterial == 2, "pre-existing");
+static_assert(lm::off::VT_ClientInstance_getLocalPlayer == 32, "pre-existing");
+static_assert(lm::off::LRP_mat_selection_overlay == 0x1030, "pre-existing");
+static_assert(lm::off::LRP_mat_selection_overlay_opaque == 0x1040, "pre-existing");
+static_assert(lm::off::LRP_mat_selection_overlay_double_sided == 0x1050, "pre-existing");
+static_assert(lm::off::LRP_mat_cracks_overlay == 0x1060, "pre-existing");
+static_assert(lm::off::LRP_mat_selection_box == 0x1090, "pre-existing");
+
+namespace {
+int gFails = 0, gPass = 0;
+#define CHECK(c)                                                                        \
+  do {                                                                                  \
+    if (c) ++gPass;                                                                     \
+    else { ++gFails; std::fprintf(stderr, "FAIL %s:%d %s\n", __FILE__, __LINE__, #c); } \
+  } while (0)
+}  // namespace
+
+int main() {
+  // Runtime mirror of the static_asserts, so the test reports a count rather than only failing to build.
+  CHECK(lm::off::Tess_mVertexRun == 0x10);
+  CHECK(lm::off::Tess_mColorRun == 0x70);
+  CHECK(lm::off::Tess_mVertexCount == 0x290);
+  CHECK(lm::off::Tess_mOffset == 0x1cc);
+  CHECK(lm::off::BlockTess_mRenderFlag == 0x78);
+  CHECK(lm::off::LevelRenderer_mLevelRendererPlayer == 0x420);
+  CHECK(lm::off::LevelRendererPlayer_mCamPos == 0x628);
+  CHECK(lm::off::ScreenContext_mTessellator == 0xB8);
+  CHECK(lm::off::ScreenContext_mColorHolder == 0x30);
+  CHECK(lm::off::Actor_mDimension == 448);
+  CHECK(lm::off::Dimension_mBlockSource == 208);
+  std::printf("offsets: %d passed, %d failed (binary validation PENDING - no libminecraftpe.so)\n", gPass,
+              gFails);
+  return gFails ? 1 : 0;
+}
diff -ruN a/tests/perf_test.cpp b/tests/perf_test.cpp
--- a/tests/perf_test.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/perf_test.cpp	2026-10-24 14:45:19.172862257 +0000
@@ -0,0 +1,244 @@
+// Phase 0 tests: perf counter semantics and frame-time percentiles (host, ASan+UBSan).
+//
+// These cover what Phase 0 added:
+//   * new counters do not disturb the indices or the printed fields of the existing ones;
+//   * count() / countMax() / noteFrameUs() behave as documented;
+//   * the percentile ring is bounded, rejects invalid samples, and computes nearest-rank correctly;
+//   * takeLine() still emits the pre-Phase-0 fields unchanged, and takePhaseLine() describes the same
+//     window rather than a second, differently-aligned one.
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include "../src/Perf.hpp"
+
+namespace {
+int gFails = 0, gPass = 0;
+#define CHECK(c)                                                                        \
+  do {                                                                                  \
+    if (c) ++gPass;                                                                     \
+    else { ++gFails; std::fprintf(stderr, "FAIL %s:%d %s\n", __FILE__, __LINE__, #c); } \
+  } while (0)
+
+using namespace lm::perf;
+
+// setEnabled() only resets the ring on a false->true transition (Perf.cpp returns early when the value is
+// unchanged, which is correct: uiLoop re-asserts the same value every pass and must not clear the window).
+// Tests that need a clean window therefore have to cycle it explicitly.
+void resetWindow() {
+  setEnabled(false);
+  setEnabled(true);
+  for (int i = 0; i < CounterCount; ++i) gCnt[i].store(0);
+}
+
+// The pre-Phase-0 log line, captured field by field so a regression in an EXISTING field is caught even
+// though many new fields were appended after it.
+bool hasField(const char *line, const char *name) { return std::strstr(line, name) != nullptr; }
+
+void testExistingCountersUnchanged() {
+  // Appending must not move any pre-existing counter. These are the indices the old log line depended on.
+  CHECK(RenderHook == 0);
+  CHECK(PlayerUpdate == 1);
+  CHECK(HoloCpuUs == 10);
+  CHECK(HoloCompares == 11);
+  CHECK(HoloBuilds == 12);
+  CHECK(HoloImmQuads == 13);
+  CHECK(SafeReads == 20);
+  CHECK(SvCalls == 21);
+  CHECK(SvHits == 22);
+  // The Phase 0 block starts immediately after the last pre-existing counter.
+  CHECK(HoloHookUs == 23);
+  CHECK(ChainSpinMaxUs == CounterCount - 1);
+  CHECK(CounterCount > 23);
+}
+
+void testCountGatedByEnable() {
+  setEnabled(false);
+  gCnt[HoloHookUs].store(0);
+  count(HoloHookUs, 1234);
+  CHECK(gCnt[HoloHookUs].load() == 0);  // off: instrumentation must be free, i.e. no increment
+
+  setEnabled(true);
+  gCnt[HoloHookUs].store(0);
+  count(HoloHookUs, 1234);
+  CHECK(gCnt[HoloHookUs].load() == 1234);
+  count(HoloHookUs);  // default n == 1
+  CHECK(gCnt[HoloHookUs].load() == 1235);
+}
+
+void testCountMaxIsMaximumNotSum() {
+  setEnabled(true);
+  gCnt[HoloBuildMaxUs].store(0);
+  countMax(HoloBuildMaxUs, 500);
+  countMax(HoloBuildMaxUs, 900);
+  countMax(HoloBuildMaxUs, 100);  // smaller: must NOT lower it and must NOT add to it
+  CHECK(gCnt[HoloBuildMaxUs].load() == 900);
+  countMax(HoloBuildMaxUs, 1200);
+  CHECK(gCnt[HoloBuildMaxUs].load() == 1200);
+
+  setEnabled(false);
+  gCnt[HoloBuildMaxUs].store(7);
+  countMax(HoloBuildMaxUs, 99999);
+  CHECK(gCnt[HoloBuildMaxUs].load() == 7);  // gated off, like count()
+}
+
+void testFrameSamplesRejectInvalid() {
+  setEnabled(true);  // resets the ring
+  CHECK(gFrameCount.load() == 0);
+
+  noteFrameUs(0);           // zero: not a real frame
+  CHECK(gFrameCount.load() == 0);
+  noteFrameUs(60000001ull);  // >60 s: clock artefact
+  CHECK(gFrameCount.load() == 0);
+
+  noteFrameUs(16000);
+  CHECK(gFrameCount.load() == 1);
+  CHECK(gFrameUs[0].load() == 16000);
+
+  setEnabled(false);
+  const uint32_t before = gFrameCount.load();
+  noteFrameUs(16000);
+  CHECK(gFrameCount.load() == before);  // gated off
+}
+
+void testRingIsBoundedAndWraps() {
+  resetWindow();
+  for (unsigned i = 0; i < kFrameSamples * 2 + 37; ++i) noteFrameUs(1000 + i);
+  // The counter is monotonic (so the window length is knowable) but the ring never grows past capacity.
+  CHECK(gFrameCount.load() == kFrameSamples * 2 + 37);
+  // Newest sample landed at index (count-1) % capacity.
+  CHECK(gFrameUs[(kFrameSamples * 2 + 36) % kFrameSamples].load() == 1000 + kFrameSamples * 2 + 36);
+}
+
+// Drive takeLine()/takePhaseLine() and assert on the printed text. The cadence is 1 s, so the first call
+// after enabling is the one that produces a line.
+void testEnableIsIdempotentAndOnlyResetsOnTransition() {
+  resetWindow();
+  noteFrameUs(16000);
+  CHECK(gFrameCount.load() == 1);
+  setEnabled(true);                    // same value again: must NOT clear the window
+  CHECK(gFrameCount.load() == 1);
+  noteFrameUs(16000);
+  CHECK(gFrameCount.load() == 2);
+  setEnabled(false);
+  setEnabled(true);                    // real transition: window cleared
+  CHECK(gFrameCount.load() == 0);
+}
+
+void testLines() {
+  resetWindow();
+  // A known frame-time distribution: 100 samples, 1..100 ms.
+  for (uint32_t i = 1; i <= 100; ++i) noteFrameUs(i * 1000u);
+  count(RenderHook, 100);
+  count(HoloHookUs, 100 * 500);
+  count(HoloBuildMaxUs, 0);
+  countMax(HoloBuildMaxUs, 4200);
+
+  char line[2048] = {};
+  // takeLine() enforces a >=1 s window; spin the clock by calling until it fires (bounded).
+  bool got = false;
+  for (int attempt = 0; attempt < 400 && !got; ++attempt) {
+    got = takeLine(line, sizeof(line));
+    if (!got) {
+      struct timespec ts {0, 5 * 1000 * 1000};
+      nanosleep(&ts, nullptr);
+    }
+  }
+  CHECK(got);
+  if (!got) return;
+
+  // Pre-Phase-0 fields must still be present and still named the same.
+  CHECK(hasField(line, "[perf] frame_id="));
+  CHECK(hasField(line, "fps="));
+  CHECK(hasField(line, "frame_time_ms="));
+  CHECK(hasField(line, "render_hook_calls="));
+  CHECK(hasField(line, "holo_cpu_ms="));
+  CHECK(hasField(line, "holo_compares="));
+  CHECK(hasField(line, "holo_chunk_builds="));
+  CHECK(hasField(line, "holo_imm_quads="));
+  CHECK(hasField(line, "safe_reads_per_s="));
+
+  // The Phase 0 line describes the same window.
+  char pl[2048] = {};
+  CHECK(takePhaseLine(pl, sizeof(pl)));
+  CHECK(hasField(pl, "[perf:phase]"));
+  CHECK(hasField(pl, "hook_us="));
+  CHECK(hasField(pl, "build_max_us="));
+  CHECK(hasField(pl, "frame_ms p50="));
+  CHECK(hasField(pl, "samples=100"));
+
+  // Nearest-rank over 1..100 ms: p50 -> rank 50 -> 50 ms, p95 -> rank 95 -> 95 ms,
+  // p99 -> rank 99 -> 99 ms, max -> 100 ms.
+  CHECK(hasField(pl, "p50=50.00"));
+  CHECK(hasField(pl, "p95=95.00"));
+  CHECK(hasField(pl, "p99=99.00"));
+  CHECK(hasField(pl, "max=100.00"));
+  // The window maximum is reported as a maximum, not folded into the average.
+  CHECK(hasField(pl, "build_max_us=4200"));
+
+  // Consumed: a second call has nothing new.
+  char pl2[64] = {};
+  CHECK(!takePhaseLine(pl2, sizeof(pl2)));
+}
+
+void testSingleSamplePercentiles() {
+  resetWindow();
+  noteFrameUs(33333);  // one sample only
+  count(RenderHook, 1);
+  char line[2048] = {};
+  bool got = false;
+  for (int attempt = 0; attempt < 400 && !got; ++attempt) {
+    got = takeLine(line, sizeof(line));
+    if (!got) {
+      struct timespec ts {0, 5 * 1000 * 1000};
+      nanosleep(&ts, nullptr);
+    }
+  }
+  CHECK(got);
+  if (!got) return;
+  char pl[2048] = {};
+  CHECK(takePhaseLine(pl, sizeof(pl)));
+  // n==1: every percentile is that sample, and no out-of-range index is possible.
+  CHECK(hasField(pl, "p50=33.33"));
+  CHECK(hasField(pl, "p95=33.33"));
+  CHECK(hasField(pl, "p99=33.33"));
+  CHECK(hasField(pl, "max=33.33"));
+  CHECK(hasField(pl, "samples=1"));
+}
+
+void testNoSamplesDoesNotDivideByZero() {
+  resetWindow();
+  // No noteFrameUs at all.
+  char line[2048] = {};
+  bool got = false;
+  for (int attempt = 0; attempt < 400 && !got; ++attempt) {
+    got = takeLine(line, sizeof(line));
+    if (!got) {
+      struct timespec ts {0, 5 * 1000 * 1000};
+      nanosleep(&ts, nullptr);
+    }
+  }
+  CHECK(got);
+  if (!got) return;
+  char pl[2048] = {};
+  CHECK(takePhaseLine(pl, sizeof(pl)));
+  CHECK(hasField(pl, "samples=0"));
+  CHECK(hasField(pl, "p50=0.00"));
+  CHECK(hasField(pl, "max=0.00"));
+}
+}  // namespace
+
+int main() {
+  testExistingCountersUnchanged();
+  testCountGatedByEnable();
+  testCountMaxIsMaximumNotSum();
+  testFrameSamplesRejectInvalid();
+  testRingIsBoundedAndWraps();
+  testEnableIsIdempotentAndOnlyResetsOnTransition();
+  testLines();
+  testSingleSamplePercentiles();
+  testNoSamplesDoesNotDivideByZero();
+  lm::perf::setEnabled(false);
+  std::printf("perf: %d passed, %d failed\n", gPass, gFails);
+  return gFails ? 1 : 0;
+}
