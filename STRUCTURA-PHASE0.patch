diff -ruN a/tests/compat/hookchain_phase0_test.cpp b/tests/compat/hookchain_phase0_test.cpp
--- a/tests/compat/hookchain_phase0_test.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/compat/hookchain_phase0_test.cpp	2026-10-24 14:46:08.377110777 +0000
@@ -0,0 +1,148 @@
+// Phase 0 tests: hook-chain wait behaviour (host, ASan+UBSan).
+//
+// Complements compat/hookchain_test.cpp, which covers the pre-existing chain model. These cover what
+// Phase 0 changed in chainNext(): the wait is still unbounded and still always returns a valid pointer,
+// but it now yields the CPU after kSpinBeforeYield attempts and records the wait in SpinStats.
+//
+// The two invariants that must survive any change here, restated as tests:
+//   * a call arriving during the install window WAITS and then reaches the game (never returns null,
+//     never skips the call-through);
+//   * the slot is read on every call, never cached.
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <thread>
+
+#include "../../src/HookChain.hpp"
+
+namespace {
+int gFails = 0, gPass = 0;
+#define CHECK(c)                                                                        \
+  do {                                                                                  \
+    if (c) ++gPass;                                                                     \
+    else { ++gFails; std::fprintf(stderr, "FAIL %s:%d %s\n", __FILE__, __LINE__, #c); } \
+  } while (0)
+
+using Fn = int (*)(int);
+using namespace lm::hookchain;
+
+std::atomic<int> gGameCalls{0};
+int game(int v) { gGameCalls.fetch_add(1); return v + 1000; }
+
+Fn gSlot = nullptr;
+int ourDetour(int v, SpinStats *st) { return chainNext(gSlot, st)(v) + 1; }
+
+void testFastPathDoesNotRecordAWait() {
+  gSlot = &game;
+  gGameCalls = 0;
+  SpinStats st;
+  CHECK(ourDetour(5, &st) == 1006);
+  CHECK(gGameCalls == 1);
+  // The overwhelmingly common case: the slot is already populated, so nothing is recorded and the
+  // stats path is never entered.
+  CHECK(st.waits.load() == 0);
+  CHECK(st.maxWaitUs.load() == 0);
+}
+
+void testWaitIsRecordedAndStillCallsThrough() {
+  gSlot = nullptr;
+  gGameCalls = 0;
+  SpinStats st;
+  std::atomic<bool> started{false};
+  int got = 0;
+  std::thread caller([&] {
+    started = true;
+    got = ourDetour(5, &st);
+  });
+  while (!started) {
+  }
+  // Long enough to force the waiter well past kSpinBeforeYield, so the yielding path is exercised.
+  std::this_thread::sleep_for(std::chrono::milliseconds(30));
+  __atomic_store_n(&gSlot, &game, __ATOMIC_RELEASE);
+  caller.join();
+
+  // Invariant 1: the call still reaches the game exactly once, with the right result.
+  CHECK(got == 1006);
+  CHECK(gGameCalls == 1);
+  // Invariant 2: the wait was observed, not silently absorbed.
+  CHECK(st.waits.load() == 1);
+  // A ~30 ms window must register as a non-trivial wait (monotonic us).
+  CHECK(st.maxWaitUs.load() > 1000);
+}
+
+void testStatsOptional() {
+  // chainNext() with no stats must behave exactly like the original busy loop.
+  gSlot = nullptr;
+  gGameCalls = 0;
+  std::atomic<bool> started{false};
+  int got = 0;
+  std::thread caller([&] {
+    started = true;
+    got = chainNext(gSlot)(5) + 1;
+  });
+  while (!started) {
+  }
+  std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  __atomic_store_n(&gSlot, &game, __ATOMIC_RELEASE);
+  caller.join();
+  CHECK(got == 1006);
+  CHECK(gGameCalls == 1);
+}
+
+void testSlotRereadEveryCall() {
+  // A cached copy would miss this: the slot is rewritten between the two calls and the second call must
+  // follow the new chain element.
+  SpinStats st;
+  gGameCalls = 0;
+  gSlot = &game;
+  CHECK(chainNext(gSlot, &st)(1) == 1001);
+
+  static std::atomic<int> otherCalls{0};
+  otherCalls = 0;
+  auto other = +[](int v) { otherCalls.fetch_add(1); return v + 2000; };
+  __atomic_store_n(&gSlot, other, __ATOMIC_RELEASE);
+  CHECK(chainNext(gSlot, &st)(1) == 2001);
+  CHECK(otherCalls == 1);
+  CHECK(gGameCalls == 1);  // the game was NOT called the second time
+}
+
+void testManyWaitsAccumulate() {
+  gSlot = nullptr;
+  SpinStats st;
+  constexpr int kRounds = 8;
+  std::atomic<bool> stop{false};
+  std::atomic<int> completed{0};
+  // A waiter that repeatedly finds a null slot, and a writer that fills and clears it.
+  std::thread waiter([&] {
+    while (!stop.load()) {
+      chainNext(gSlot, &st)(0);
+      completed.fetch_add(1);
+    }
+  });
+  for (int i = 0; i < kRounds; ++i) {
+    __atomic_store_n(&gSlot, static_cast<Fn>(nullptr), __ATOMIC_RELEASE);
+    std::this_thread::sleep_for(std::chrono::milliseconds(3));
+    __atomic_store_n(&gSlot, &game, __ATOMIC_RELEASE);
+    std::this_thread::sleep_for(std::chrono::milliseconds(3));
+  }
+  stop = true;
+  __atomic_store_n(&gSlot, &game, __ATOMIC_RELEASE);
+  waiter.join();
+
+  // Every completed call went through the chain, and the waits that occurred were all counted.
+  CHECK(completed.load() > 0);
+  CHECK(st.waits.load() > 0);
+  CHECK(st.waits.load() <= uint64_t(completed.load()));
+  CHECK(st.maxWaitUs.load() > 0);
+}
+}  // namespace
+
+int main() {
+  testFastPathDoesNotRecordAWait();
+  testWaitIsRecordedAndStillCallsThrough();
+  testStatsOptional();
+  testSlotRereadEveryCall();
+  testManyWaitsAccumulate();
+  std::printf("hookchain_phase0: %d passed, %d failed\n", gPass, gFails);
+  return gFails ? 1 : 0;
+}
